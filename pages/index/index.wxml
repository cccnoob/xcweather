<!--index.wxml-->
<wxs module="dateFr" src="./filter.wxs"></wxs>
<view class="container">
  <!-- <view class='search'>
    <input type='text' placeholder='请输入城市'  confirm-type='search'></input>
    <icon type="search" class='btn' size="20" color="{{item}}"/>
  </view> -->
  
  <view class='address pb'>
   <image class='navimg' src='../img/navimg.png'></image>
   <text bindtap='bindNav'>{{city.adm2}},{{city.name}}</text>
    <text class='changecity' bindtap='bindChooseAdd'>切换城市</text>
  </view>
  <view class='wemain '>
    <view class='black now pb' style="color: #fff;">
      <text class="icons qi-{{nowWeather.icon}}"></text>
      <view class='wd'><text class='wdnum'>{{nowWeather.temp}}</text>℃ </view>
    </view>
    <view class='black pb'>
      <view>天气状况：{{nowWeather.text}}</view>
      <view>空气质量：{{airData.quality.aqi}} {{airData.quality.category}}</view>
      <view>相对湿度：{{nowWeather.humidity}} %</view>
      <view>PM2.5：{{airData.pm25}} μg/m³</view>
    </view>
  </view>
  <view class='zhishu pb'>
    <view wx:for="{{indicesData}}" wx:key="index" class="items {{currentId == index ? 'active' : '' }}" data-current="{{index}}" bindtap="clickTab">
      <image src="{{ indicesIcon['type' + item.type] }}" mode='widthFix'></image>
      <view class='tit'>{{item.name}}</view>
      <view>{{item.category}}</view>
    </view>
  </view>
  <swiper class="scroll-view_H pb" current="{{currentId}}" duration="200" bindchange="swiperChange" style="width: 100%;height:100px;">
    <swiper-item wx:for="{{indicesData}}" wx:key="index" class="scroll-view-item">{{item.text}}</swiper-item>
  </swiper>
  <view class='weather-list pb'>
    <view class='item' wx:for="{{weatherData.daily}}" wx:if="{{index != 0}}" wx:key="index">
      <view>周{{dateFr.getDate(item.fxDate)}}</view>
      <view class="tqqk">
        <text class="icons qi-{{item.iconDay}}"></text>
        {{item.textDay}}
      </view>
      <view>
        {{item.tempMin}}~{{item.tempMax}}℃
      </view>
    </view>
  </view>
  <view class='updatatime'> 
    <view class='time'>{{nowTime}} </view>
    <view> 最近更新：{{weatherData.updateTime}} </view>
    <view> 备案号：鄂ICP备2025091325号-1X</view>
  </view>
</view>
