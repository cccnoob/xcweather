/**index.wxss**/
.pb {
  background: rgba(0, 0, 0, .1);
  border-radius: 5px;
}

.search {
  position: relative;
  height: 40px;
  background: #fff;
  margin: 20rpx 0;
  border-radius: 8rpx;
  display: none;
}

.search input {
  width: 100%;
  height: 40px;
  line-height: 40px;
  color: #333;
  font-size: 14px;
  padding: 0 20rpx;
}

.search .btn {
  position: absolute;
  right: 20rpx;
  top: 10px;
}

.address {
  margin: 20rpx 0;
  padding: 20rpx 10rpx;
  font-size: 18px;
}

.time {
  font-size: 14px;
}

.changecity {
  float: right;
  margin-top: 2px;
  padding-right: 10rpx;
  font-size: 16px;
}

.address .navimg {
  width: 18px;
  height: 18px;
  vertical-align: -3px;
}

.wemain {
  display: flex;
  justify-content: space-between;
  margin: 20rpx 0;
}

.wemain .black {
  width: 49.5%;
  padding: 5px 10px 5px;
  overflow: hidden;
  box-sizing: border-box;
}

.wemain .now {
  display: flex;
  justify-content: space-around;
  align-items: center;
  text-align: center;
}

.wemain .icons {
  font-size: 56px;
}

.wemain .text {
  font-size: 14px;
}

.wemain .wd {
  height: 80px;
  line-height: 80px;
  margin-left: 10px;
}

.wemain .wdnum {
  font-size: 56px;
}

.zhishu {
  display: flex;
  min-height: 100px;
  margin: 20rpx 0;
  padding: 20rpx 10rpx;
}

.zhishu .items {
  width: 20%;
  padding-bottom: 10rpx;
  text-align: center;
}

.zhishu .items image {
  width: 60%;
}

.zhishu .items .tit {
  margin: 8rpx 0;
  font-size: 13px;
  color: #cacaca;
}

.zhishu .items.active {
  border-bottom: 2px solid rgb(141, 197, 211);
}

.weather-list {
  min-height: 240px;
  padding: 5px 10px;
  font-size: 16px;
}

.weather-list .item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 5px;
  height: 40px;
  border-bottom: 1rpx solid rgb(141, 197, 211);
}

.weather-list .item:last-child {
  border-bottom: 0 none;
}

.weather-list .tqqk {
  display: flex;
  align-items: center;
  gap: 5px;
}

.weather-list .item .icons {
  font-size: 20px;
}

.updatatime {
  margin: 20rpx 0 50rpx;
  text-align: center;
  font-size: 12px;
  color: #cecece;
}

.updatatime .time {
  font-size: 14px;
}

.scroll-view_H {
  margin: 20rpx 0;
  color: #dadada;
  font-size: 16px;
}

.scroll-view-item {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}